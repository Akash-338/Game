{
  "name": "word-impostor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node backend/scripts/start-development.mjs",
    "build": "vite build --config frontend/vite.config.js && node backend/scripts/create-deployment-entry.mjs",
    "start": "node backend/scripts/start-production.mjs",
    "test": "vitest run",
    "test:game-flow": "node backend/server/game/service.numeric-check.mjs",
    "test:host-reconnect": "node backend/scripts/test-host-reconnect.mjs",
    "test:host-player": "node backend/scripts/test-host-player-mode.mjs",
    "build:frontend": "npm --prefix frontend run build",
    "start:backend": "npm --prefix backend run start",
    "test:deployment-boundary": "node backend/scripts/deployment-boundary-check.mjs",
    "validate:postgres-schema": "node backend/scripts/validate-postgres-schema.mjs",
    "test:cloud-adapters": "node backend/scripts/cloud-adapter-check.mjs",
    "test:cloud-room-rpc": "node backend/scripts/cloud-room-rpc-check.mjs",
    "test:cloud-entry-socket": "node backend/scripts/cloud-entry-socket-check.mjs",
    "seed:supabase-category-packs": "node backend/scripts/seed-supabase-category-packs.mjs",
    "audit:ui": "node backend/scripts/audit-client.mjs",
    "check": "npm test"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@socket.io/redis-adapter": "^8.3.0",
    "@supabase/supabase-js": "^2.112.4",
    "@vitejs/plugin-react": "^5.0.4",
    "express": "^4.21.2",
    "framer-motion": "^12.23.22",
    "ioredis": "^6.0.0",
    "lucide-react": "^0.453.0",
    "nanoid": "^5.1.5",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "vite": "^7.1.7"
  },
  "devDependencies": {
    "vitest": "^2.1.4"
  }
}
